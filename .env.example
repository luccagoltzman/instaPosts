# RapidAPI — API "Download All in One!" (download por link de post/reel/story).
# Assine o plano Basic (grátis, 500 créditos/mês; 2 por post, 5 por story; falhas não cobram):
# https://rapidapi.com/coder2077/api/instagram-downloader-download-instagram-videos-stories1
# Em produção (Vercel) use o nome RAPIDAPI_KEY.
VITE_RAPIDAPI_KEY=

# Instagram Graph API (Meta) — opcional, gratuita. Atende perfis profissionais (Empresa/Criador)
# antes de gastar cota da RapidAPI. Passo a passo no README ("Configurar a Graph API da Meta").
# Em produção, cadastre as mesmas variáveis nas Environment Variables da Vercel.
IG_GRAPH_TOKEN=
IG_GRAPH_USER_ID=
# IG_GRAPH_API_VERSION=v26.0
